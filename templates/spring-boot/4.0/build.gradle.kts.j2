plugins {
    java
    id("org.springframework.boot") version "{{ config.spring_boot_version }}"
    id("io.spring.dependency-management") version "1.1.7"
}

group = "{{ config.base_package }}"
version = "0.0.1-SNAPSHOT"

java {
    sourceCompatibility = JavaVersion.VERSION_{{ config.java_version.value }}
    targetCompatibility = JavaVersion.VERSION_{{ config.java_version.value }}
}

repositories {
    mavenCentral()
}

dependencies {

    // =========================================================================
    // Core — always included
    // =========================================================================
    implementation("org.springframework.boot:spring-boot-starter-actuator")
    implementation("org.springframework.boot:spring-boot-starter-opentelemetry")
    implementation("org.springframework.boot:spring-boot-starter-webmvc")
    // Renamed from spring-boot-starter-aop in Spring Boot 4
    implementation("org.springframework.boot:spring-boot-starter-aspectj")
    // OTel Logback Appender — not managed by Spring Boot BOM
    implementation("io.opentelemetry.instrumentation:opentelemetry-logback-appender-1.0:2.26.0-alpha")
    // Spring Retry — not in SB4 BOM
    implementation("org.springframework.retry:spring-retry:2.0.12")

{% if config.use_database %}
    // =========================================================================
    // Database — {{ config.database.value }}
    // =========================================================================
    implementation("org.springframework.boot:spring-boot-starter-data-jpa")
    implementation("org.flywaydb:flyway-core")
{% if config.database.value == 'postgresql' %}
    implementation("org.flywaydb:flyway-database-postgresql")
    runtimeOnly("org.postgresql:postgresql")
{% elif config.database.value == 'mysql' %}
    implementation("org.flywaydb:flyway-database-mysql")
    runtimeOnly("com.mysql:mysql-connector-j")
{% elif config.database.value == 'oracle' %}
    implementation("org.flywaydb:flyway-database-oracle")
    runtimeOnly("com.oracle.database.jdbc:ojdbc11")
{% elif config.database.value == 'h2' %}
    runtimeOnly("com.h2database:h2")
{% endif %}
{% endif %}

    // =========================================================================
    // Test
    // =========================================================================
    testImplementation("org.springframework.boot:spring-boot-starter-webmvc-test")
    testImplementation("org.springframework.boot:spring-boot-starter-opentelemetry-test")
}
